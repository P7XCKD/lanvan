### 2. Frontend: Client Integration in `main-app.js`

- Implement `initUIEventsWebSocket()` in `main-app.js`:
  - Connects to `/ws/ui-events`.
  - Listens for custom UI event types (`ui_toast`, `theme_change`, `active_user_sync`, etc.).
  - Completely decoupled from `FileRepository` and `refreshFileList()`.

```javascript
let uiEventsWs = null;

function initUIEventsWebSocket() {
  const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  const wsUrl = `${protocol}//${window.location.host}/ws/ui-events`;
  uiEventsWs = new WebSocket(wsUrl);

  uiEventsWs.onmessage = function(event) {
    try {
      const payload = JSON.parse(event.data);
      if (payload.type === 'ui_toast' && typeof window.showToast === 'function') {
        window.showToast(payload.data.message);
      }
    } catch (e) {}
  };
}
```

