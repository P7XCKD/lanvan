<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Lanvan App Theme inheriting from Theme.MaterialComponents.NoActionBar -->
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg_surface</item>
        <item name="android:colorBackground">@color/bg_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/primary_accent_blue</item>
        <item name="colorAccent">@color/primary_accent_blue</item>
    </style>

    <style name="LanvanBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/LanvanBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="LanvanBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
