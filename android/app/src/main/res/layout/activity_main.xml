<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- HEADER BAR -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@color/header_surface"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lanvan"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- STATUS INDICATOR PILL IN HEADER -->
        <LinearLayout
            android:id="@+id/header_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="12dp">

            <View
                android:id="@+id/status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_card_sub"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/header_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stopped"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings Menu"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- HIDDEN BACKWARD-COMPATIBLE STATUS BAR REFERENCE FOR CONTROLLER SYNCS -->
    <TextView
        android:id="@+id/txt_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- MAIN SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- STATE 0: STOPPED + DISCONNECTED NETWORK WARNING CARD -->
            <LinearLayout
                android:id="@+id/card_stopped_net_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_alert_triangle"
                    android:layout_marginEnd="16dp"
                    app:tint="@color/warning_amber" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No network connection"
                        android:textColor="@color/warning_amber"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connect to Wi-Fi or enable a hotspot before starting Lanvan."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- STATE 1: STOPPED SERVER CARD -->
            <LinearLayout
                android:id="@+id/card_stopped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="24dp"
                android:gravity="center"
                android:visibility="visible"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Lanvan to share files with devices on your local network."
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_start_server"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Start Lanvan"
                    android:textAllCaps="false"
                    android:textColor="#121316"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_accent_blue"
                    app:icon="@drawable/ic_play"
                    app:iconTint="#121316"
                    app:iconGravity="textStart"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- STATE 2: RUNNING SERVER + NETWORK AVAILABLE CARD -->
            <LinearLayout
                android:id="@+id/card_running_connected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="24dp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your files are available on this network."
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <ImageView
                    android:id="@+id/img_qrcode"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:background="#FFFFFF"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="QR Code to connect to server"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan to connect"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/txt_ip_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="http://192.168.1.100:5000"
                    android:textColor="@color/primary_accent_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/txt_mdns_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- BUTTON ROW: COPY & STOP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_address"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Copy"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginEnd="8dp"
                        app:backgroundTint="@android:color/transparent"
                        app:strokeColor="@color/border_outline_btn"
                        app:strokeWidth="1dp"
                        app:icon="@drawable/ic_copy"
                        app:iconTint="@color/text_primary"
                        app:iconGravity="textStart"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stop_server"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Stop Lanvan"
                        android:textAllCaps="false"
                        android:textColor="@color/danger_red_text"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginStart="8dp"
                        app:backgroundTint="@android:color/transparent"
                        app:strokeColor="@color/danger_red"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- STATE 3: RUNNING SERVER + NETWORK DEGRADED CARD -->
            <LinearLayout
                android:id="@+id/card_running_degraded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_degraded"
                android:padding="24dp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_amber_circle"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_wifi_off"
                        app:tint="@color/warning_amber" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network unavailable"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lanvan is still running, but other devices cannot connect right now. Reconnect to Wi-Fi or enable a hotspot to resume sharing."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your files are safe."
                    android:textColor="@color/primary_accent_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reconnect_wifi"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Open Wi-Fi Settings"
                    android:textAllCaps="false"
                    android:textColor="@color/warning_amber"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    app:backgroundTint="@color/bg_amber_btn"
                    app:strokeColor="@color/border_amber_btn"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_degraded_stop_server"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Stop Lanvan"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/transparent"
                    app:strokeColor="@color/border_outline_btn"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- STORAGE CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STORAGE"
                    android:textColor="@color/primary_accent_blue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txt_storage_usage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 MB"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uploaded files &amp; clipboard history"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_manage_storage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Manage Storage"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_accent_blue"
                    android:textSize="14sp"
                    app:backgroundTint="@android:color/transparent"
                    app:strokeColor="@color/primary_accent_blue"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_hard_drive"
                    app:iconTint="@color/primary_accent_blue"
                    app:iconGravity="textStart"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- SUPPORT LANVAN CARD -->
            <LinearLayout
                android:id="@+id/card_support_lanvan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUPPORT"
                    android:textColor="@color/primary_accent_blue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enjoying Lanvan?"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Help keep Lanvan free and independent."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_support_lanvan"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Support Lanvan"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@android:color/transparent"
                    app:strokeColor="@color/border_outline_btn"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_heart"
                    app:iconTint="@color/text_primary"
                    app:iconGravity="textStart"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    </LinearLayout>

    <!-- NATIVE SPOTLIGHT WALKTHROUGH OVERLAY CONTAINER -->
    <FrameLayout
        android:id="@+id/spotlight_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- CUTOUT & GLOWING HIGHLIGHT RING VIEW -->
        <com.lanvan.app.SpotlightOverlayView
            android:id="@+id/spotlight_overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- FLOATING TOOLTIP CARD -->
        <LinearLayout
            android:id="@+id/spotlight_tooltip_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:elevation="12dp">

            <!-- HEADER ROW (LOGO + APP NAME + SKIP) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Lanvan Logo"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lanvan"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_spotlight_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skip"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!-- BODY CONTENT -->
            <TextView
                android:id="@+id/txt_spotlight_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start Lanvan"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txt_spotlight_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap here to start sharing files with devices on your local network."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_spotlight_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Lanvan app is required on the other device."
                android:textColor="@color/primary_accent_blue"
                android:textSize="12sp"
                android:background="@drawable/bg_circle_blue_tint"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- FOOTER ROW (DOTS + BACK / NEXT / GET STARTED) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- 5 STEP DOT INDICATOR CONTAINER -->
                <LinearLayout
                    android:id="@+id/spotlight_dots_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="16dp">

                    <View android:id="@+id/dot_step_1" android:layout_width="18dp" android:layout_height="6dp" android:background="@drawable/bg_dot_active" android:layout_marginEnd="4dp" />
                    <View android:id="@+id/dot_step_2" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_dot_inactive" android:layout_marginEnd="4dp" />
                    <View android:id="@+id/dot_step_3" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_dot_inactive" android:layout_marginEnd="4dp" />
                    <View android:id="@+id/dot_step_4" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_dot_inactive" android:layout_marginEnd="4dp" />
                    <View android:id="@+id/dot_step_5" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_dot_inactive" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- NAV BUTTONS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_spotlight_back"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Back"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:layout_marginEnd="8dp"
                    app:strokeColor="@color/border_outline_btn"
                    app:strokeWidth="1dp"
                    app:cornerRadius="19dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_spotlight_next"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Next"
                    android:textAllCaps="false"
                    android:textColor="#041E49"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_accent_blue"
                    app:cornerRadius="19dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_spotlight_finish"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Get Started"
                    android:textAllCaps="false"
                    android:textColor="#041E49"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@color/primary_accent_blue"
                    app:cornerRadius="19dp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
