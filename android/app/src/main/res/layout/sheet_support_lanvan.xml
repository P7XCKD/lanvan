<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top_rounded"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Support Lanvan"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close_support"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- SUPPORT HEART CIRCLE -->
    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:background="@drawable/bg_circle_blue_tint"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_heart"
            app:tint="@color/primary_accent_blue" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lanvan is completely free to use"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="If you find Lanvan helpful, optional support helps keep the project free, open-source, and independent."
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="20dp" />

    <!-- SUPPORT TIERS GRID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <!-- TIER 1: ₹39 -->
        <LinearLayout
            android:id="@+id/tier_card_49"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_sub"
            android:padding="14dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txt_tier_val_49"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹39"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_tier_name_49"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supporter"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- TIER 2: ₹149 (DEFAULT ACTIVE) -->
        <LinearLayout
            android:id="@+id/tier_card_159"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_sub"
            android:padding="14dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txt_tier_val_159"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹149"
                android:textColor="@color/primary_accent_blue"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_tier_name_159"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sponsor"
                android:textColor="@color/primary_accent_blue"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- TIER 3: ₹399 -->
        <LinearLayout
            android:id="@+id/tier_card_399"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_sub"
            android:padding="14dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txt_tier_val_399"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹399"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_tier_name_399"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patron"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_confirm_support"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="#041E49"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary_accent_blue" />

</LinearLayout>
