<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top_rounded"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Background operation"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close_background"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_muted"
            android:contentDescription="Close" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Keep Lanvan running when the app is in the background."
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <!-- DYNAMIC STATUS CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_sub"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUS"
            android:textColor="@color/primary_accent_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txt_background_detail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allowed"
            android:textColor="@color/primary_accent_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txt_background_detail_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lanvan is allowed to run continuously in the background without battery restrictions."
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- CONFIGURE BUTTON -->
    <Button
        android:id="@+id/btn_configure_battery"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Configure Background Access"
        android:textAllCaps="false"
        android:textColor="@color/primary_accent_blue"
        android:textSize="14sp"
        app:strokeColor="@color/primary_accent_blue" />

</LinearLayout>
